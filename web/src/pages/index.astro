---
import BaseLayout from "../layouts/BaseLayout.astro";

import { url } from "../lib/url";

const GITHUB_URL = "https://github.com/jihedmastouri/sqlide";

const features = [
  {
    title: "Schema browser",
    text: "Tables, views, and functions per connection, with columns and their types laid out inline.",
    path: "M3 4h18v16H3zM3 9h18M9 9v11",
  },
  {
    title: "Editable data grid",
    text: "Paged table browsing with inline cell edits, committed as primary-key UPDATEs. Views and PK-less tables stay read-only.",
    path: "M3 5h18v14H3zM3 10h18M3 15h18M9 5v14M15 5v14",
  },
  {
    title: "Query console",
    text: "A SQL editor with syntax highlighting and keyword completion. Run with Ctrl+Enter, see results in the same grid.",
    path: "M4 6l5 5-5 5M13 16h7",
  },
  {
    title: "Workspaces",
    text: "Group connections and tabs into a workspace; close it and reopen later exactly as you left it.",
    path: "M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
  },
  {
    title: "Create / drop DDL",
    text: "A small table designer, dialect-correct skeletons for the rest, and drop dialogs that show the exact statement first.",
    path: "M12 4v16M4 12h16",
  },
  {
    title: "Language server completion",
    text: "Schema-aware completion via Postgres Language Server or sqls, merged into the built-in keyword completion.",
    path: "M12 3l8 4.5v9L12 21l-8-4.5v-9zM12 12l8-4.5M12 12v9M12 12L4 7.5",
  },
  {
    title: "MCP server",
    text: "Expose a workspace's connections to an AI assistant over MCP — read-only by construction, with a query guard and token auth.",
    path: "M6 3v6a3 3 0 0 0 3 3h6a3 3 0 0 1 3 3v6M6 3H4m2 0h2m10 18h-2m2 0h2",
  },
  {
    title: "Keyring-backed passwords",
    text: "Connection passwords stored in the system keyring when one is available, instead of plain JSON.",
    path: "M6 11h12v9H6zM9 11V7a3 3 0 0 1 6 0v4",
  },
];

const details = [
  { k: "Platform", v: "Linux — GTK4 + libadwaita" },
  { k: "Language", v: "Python 3.12+" },
  { k: "Databases", v: "SQLite, MySQL, PostgreSQL, JDBC (experimental)" },
  { k: "License", v: "Source available on GitHub" },
];
---

<BaseLayout title="sqlide — a minimal SQL IDE">
  <section class="hero">
    <div class="wrap">
      <span class="badge"><span class="dot"></span> Built with GTK4 and libadwaita</span>
      <h1>
        A minimal SQL IDE.<br />
        <span class="dim">Nothing extra in the way.</span>
      </h1>
      <p class="tagline">
        sqlide connects to SQLite, MySQL, and PostgreSQL. Browse schemas, page
        through data, edit cells, and run queries — in a native desktop app that
        starts fast and stays out of your way.
      </p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url("/docs/installation/")}>Get started</a>
        <a class="btn btn-secondary" href={GITHUB_URL}>View source</a>
      </div>
      <p class="hero-note">Run it from source with <code>pip install .</code> — no packaging required.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Features</p>
      <h2 class="section-title">Everything you need, and no more</h2>
      <p class="section-sub">
        Built in the spirit of DBeaver or DataGrip, but deliberately basic. No
        visual query builder, no ER diagrams, no SSH tunnel wizards — a small,
        fast tool to look at a database and run some SQL.
      </p>
      <div class="grid">
        {
          features.map((f) => (
            <div class="card">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d={f.path} />
              </svg>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="install-grid">
        <div>
          <p class="eyebrow">Install</p>
          <h2 class="section-title">Up and running in four lines</h2>
          <p class="section-sub">
            sqlide isn't packaged yet — run it from source. Python 3.12+ and
            GTK4 + libadwaita are the only hard requirements; database drivers
            are optional extras you install as needed. SQLite needs nothing
            extra.
          </p>
          <div class="btn-row">
            <a class="btn btn-secondary" href={url("/docs/installation/")}>MySQL, Postgres, JDBC, MCP and keyring extras</a>
          </div>
        </div>
        <div class="terminal">
          <div class="terminal-bar">
            <span class="dots"><i></i><i></i><i></i></span>
            <span>bash</span>
          </div>
          <pre><code><span class="prompt">$ </span>git clone {GITHUB_URL}.git
<span class="prompt">$ </span>cd sqlide
<span class="prompt">$ </span>pip install .
<span class="prompt">$ </span>sqlide</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="install-grid">
        <div>
          <p class="eyebrow">Details</p>
          <h2 class="section-title">What it runs on</h2>
          <p class="section-sub">
            A native Linux desktop app, not an Electron shell. The whole thing
            is Python and GTK.
          </p>
        </div>
        <ul class="meta-list">
          {
            details.map((d) => (
              <li>
                <span class="k">{d.k}</span>
                <span class="v">{d.v}</span>
              </li>
            ))
          }
          <li>
            <span class="k">Source</span>
            <span class="v"><a href={GITHUB_URL}>github.com/jihedmastouri/sqlide</a></span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="wrap">
      <h2>Open a database.</h2>
      <p>Point it at a file or a connection string and start querying.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url("/docs/")}>Read the docs</a>
        <a class="btn btn-secondary" href={GITHUB_URL}>Star on GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>
